<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LOIC</RootNamespace>
    <AssemblyName>LOIC</AssemblyName>
    <StartupObject>LOIC.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\LOIC.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Die resx-Dateien enthalten noch BinaryFormatter-serialisierte Bitmaps.
         Der Build reicht diese als vorserialisierte Ressourcen durch. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>

    <!-- Assembly-Metadaten, migriert aus dem frueheren Properties/AssemblyInfo.cs -->
    <AssemblyTitle>Low Orbit Ion Cannon</AssemblyTitle>
    <Description>TCP/IP stress-test tool</Description>
    <Product>Low Orbit Ion Cannon</Product>
    <Copyright>Public domain</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AssemblyVersion>2.9.9.99</AssemblyVersion>
    <FileVersion>2.9.9.99</FileVersion>
    <Version>2.9.9.99</Version>
  </PropertyGroup>

  <!-- Das LOIC-Projekt liegt in src/, das IRC-Projekt in src/IRC/. Den IRC-Unterbaum
       aus den Default-Globs des SDK herausnehmen, damit seine Dateien nicht doppelt
       kompiliert werden. -->
  <ItemGroup>
    <Compile Remove="IRC\**" />
    <EmbeddedResource Remove="IRC\**" />
    <None Remove="IRC\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="IRC\IRC.csproj" />
  </ItemGroup>

</Project>
