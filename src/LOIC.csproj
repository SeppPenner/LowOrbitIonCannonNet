<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LOIC</RootNamespace>
    <AssemblyName>LOIC</AssemblyName>
    <StartupObject>LOIC.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\LOIC.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- The resx files still carry BinaryFormatter-serialized bitmaps. The build passes
         them through as preserialized resources. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>

    <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs -->
    <AssemblyTitle>Low Orbit Ion Cannon</AssemblyTitle>
    <Description>TCP/IP stress-test tool</Description>
    <Product>Low Orbit Ion Cannon</Product>
    <Copyright>Public domain</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AssemblyVersion>2.9.9.99</AssemblyVersion>
    <FileVersion>2.9.9.99</FileVersion>
    <Version>2.9.9.99</Version>
  </PropertyGroup>

  <!-- The LOIC project lives in src/, the IRC project in src/IRC/. Exclude the IRC
       subtree from the SDK default globs so its files are not compiled twice. -->
  <ItemGroup>
    <Compile Remove="IRC\**" />
    <EmbeddedResource Remove="IRC\**" />
    <None Remove="IRC\**" />
  </ItemGroup>

  <!-- System.Configuration.ConfigurationManager and System.Resources.Extensions are
       already part of the Windows Desktop shared framework on net10.0-windows, so no
       explicit PackageReference is needed (see NU1510). -->

  <ItemGroup>
    <ProjectReference Include="IRC\IRC.csproj" />
  </ItemGroup>

</Project>
